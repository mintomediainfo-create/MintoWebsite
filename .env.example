# Postgres (Vercel Postgres / Neon gives you this)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# long random text, used to sign the admin login cookie
JWT_SECRET=change-me-to-a-long-random-string
# first admin account (created by: npm run db:seed)
ADMIN_EMAIL=admin@mintomediaagency.com
ADMIN_PASSWORD=
# Cloudflare R2 (leave empty in local dev: files are saved to server/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=minto-media
R2_PUBLIC_URL=https://media.mintomediaagency.com
# Email for the newsletter (any SMTP account). Leave SMTP_HOST empty in local dev: emails are only printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Minto Media <no-reply@mintomediaagency.com>
SITE_URL=https://mintomediaagency.com
