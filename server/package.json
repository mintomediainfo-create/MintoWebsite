{
  "name": "server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:content": "tsx src/content.ts",
    "media:upload": "tsx src/uploadMedia.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.11.10",
    "tsx": "^4.20.6",
    "typescript": "5.6.3"
  }
}
